# GitHub Pages deploy settings (dockerized deploy container). Copy to .env and fill in.
# Token: GitHub -> Settings -> Developer settings -> Personal access tokens (classic)
#        scopes: `repo` (or fine-grained: Contents RW + Pages RW on the target repo)
GITHUB_TOKEN=
# Target repo, must already exist on GitHub, e.g. you/druk-keys (public on free plan).
GITHUB_REPO=
# Pages branch (default gh-pages).
PAGES_BRANCH=gh-pages
